# Modèle du fichier `.env` de PRODUCTION (docs/deploy.md).
# Sur le serveur : cp docker/env.production.example .env && chmod 600 .env
# Ce fichier est lu par Docker Compose (interpolation de compose.prod.yml) et par les scripts
# de docker/ (cron-job.sh, backup.sh). Jamais versionné (.gitignore : .env*).
# Pas de guillemets autour des valeurs : Compose les garderait tels quels.

# Les commandes `docker compose …` utilisent la stack de production sans `-f`.
COMPOSE_FILE=compose.prod.yml

# --- PostgreSQL ---------------------------------------------------------------------------
# La base n'est joignable que sur le réseau Docker interne. DATABASE_URL est construite par
# compose.prod.yml à partir de ces trois valeurs.
POSTGRES_USER=refarchives
POSTGRES_DB=refarchives
# Hexadécimal uniquement (il entre dans une URL) : openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Application --------------------------------------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=
# URL publique : base de tous les liens des emails, et hôte attendu par le garde-fou de proxy.ts.
APP_URL=https://ref.clement-hervouet.fr

# --- SMTP : relais postfix (boky/postfix) sur le réseau caddy_default ---------------------
# Nom du conteneur postfix (docker ps --format '{{.Names}}'), ou son alias sur caddy_default.
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_SECURE=false
# true : pas de STARTTLS vers le postfix (certificat auto-signé CN=localhost, invérifiable).
# Le trafic app → postfix reste dans le réseau Docker ; postfix → Gmail reste chiffré.
# Interdit avec SMTP_USER (l'application refuse de démarrer).
SMTP_IGNORE_TLS=true
# Vides : le relais accepte les réseaux Docker privés sans authentification.
SMTP_USER=
SMTP_PASSWORD=
# Adresse de l'alias Gmail « Envoyer en tant que » (sinon Gmail réécrit l'expéditeur).
# Son domaine doit figurer dans ALLOWED_SENDER_DOMAINS du conteneur postfix.
EMAIL_FROM=REF-Archives <ref@clement-hervouet.fr>

# --- Jobs planifiés -----------------------------------------------------------------------
# Secret des routes /api/cron/* (crons de l'hôte, docker/cron-job.sh). openssl rand -base64 32
CRON_SECRET=

# --- Sauvegardes (docker/backup.sh) -------------------------------------------------------
BACKUP_DIR=/var/backups/ref-archives
BACKUP_RETENTION_DAYS=14
# Copie distante par rsync over SSH (clé SSH de l'utilisateur qui lance le cron). Vide = pas de copie.
BACKUP_REMOTE=utilisateur@machine-distante:/chemin/ref-archives-backups/
