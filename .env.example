NODE_ENV=development
# Postgres (utilisé par docker-compose.yml ET par l'app)
POSTGRES_USER=refarchives
POSTGRES_PASSWORD=change-me
POSTGRES_DB=refarchives
DATABASE_URL=postgres://refarchives:change-me@localhost:5432/refarchives
# Générer avec : openssl rand -base64 32
AUTH_SECRET=remplace-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum