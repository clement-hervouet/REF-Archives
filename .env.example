NODE_ENV=development
# Postgres (utilisé par docker-compose.yml ET par l'app)
POSTGRES_USER=refarchives
POSTGRES_PASSWORD=change-me
POSTGRES_DB=refarchives
DATABASE_URL=postgres://refarchives:change-me@localhost:5432/refarchives
# Générer avec : openssl rand -base64 32
AUTH_SECRET=remplace-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum

# URL publique de l'app : base des liens dans les emails. En production : https obligatoire.
APP_URL=http://localhost:3000

# SMTP. En dev : compte Ethereal (https://ethereal.email → « Create Ethereal Account »).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# true = TLS implicite (port 465) ; false = STARTTLS (587) ou relais local sans TLS.
SMTP_SECURE=false
# Laisser SMTP_USER et SMTP_PASSWORD vides si le relais n'exige pas d'authentification.
SMTP_USER=remplace-moi
SMTP_PASSWORD=remplace-moi
# Gmail réécrit l'expéditeur avec l'adresse du compte utilisé par le relais.
EMAIL_FROM=REF-Archives <no-reply@refarchives.example>