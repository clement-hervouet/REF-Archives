{
  "name": "ref-archives",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose --env-file .env.local --profile dev up -d",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/db.mts migrate",
    "db:seed": "node --env-file=.env.local --experimental-strip-types scripts/db.mts seed",
    "db:reset": "node --env-file=.env.local --experimental-strip-types scripts/db.mts reset",
    "admin:create": "node --env-file=.env.local scripts/admin-create.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}