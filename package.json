{
  "name": "ref-archives",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests",
    "db:up": "docker compose --env-file .env.local --profile dev up -d",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/db.mts migrate",
    "db:seed": "node --env-file=.env.local --experimental-strip-types scripts/db.mts seed",
    "db:reset": "node --env-file=.env.local --experimental-strip-types scripts/db.mts reset",
    "admin:create": "node --env-file=.env.local scripts/admin-create.mts",
    "email:test": "node --env-file=.env.local scripts/email-test.mts",
    "knip": "knip"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "canvas-confetti": "1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-snowfall": "2.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.44.2",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
